FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver               GAMG;
        tolerance            1e-05;
        relTol               1e-02;
        smoother             GaussSeidel;
        cacheAgglomeration   true;
        nCellsInCoarsestLevel 10;
        agglomerator         faceAreaPair;
        mergeLevels          1;
    }

    pFinal
    {
        $p;
        relTol               1e-02;
    }

    "(U|k|epsilon)"
    {
        solver               smoothSolver;
        smoother             DILUGaussSeidel;
        tolerance            1e-04;
        relTol               0.2;
    }

    "(U|k|epsilon)Final"
    {
        $U;
        relTol               1e-02;
    }

    omega
    {
        solver               smoothSolver;
        smoother             DILUGaussSeidel;
        tolerance            1e-04;
        relTol               0.2;
    }
    omegaFinal
    {
        $omega;
        relTol               1e-02;
    }

    nuTilda
    {
        solver               smoothSolver;
        smoother             DILUGaussSeidel;
        tolerance            1e-04;
        relTol               0.2;
    }
    nuTildaFinal
    {
        $nuTilda;
        relTol               1e-02;
    }

    nut
    {
        solver               smoothSolver;
        smoother             DILUGaussSeidel;
        tolerance            1e-04;
        relTol               0.2;
    }
    nutFinal
    {
        $nut;
        relTol               1e-02;
    }

    T
    {
        solver               smoothSolver;
        smoother             DILUGaussSeidel;
        tolerance            1e-06;
        relTol               0.1;
    }
    TFinal
    {
        $T;
        relTol               0.01;
    }

    h
    {
        solver               smoothSolver;
        smoother             DILUGaussSeidel;
        tolerance            1e-06;
        relTol               0.1;
    }
    hFinal
    {
        $h;
        relTol               0.01;
    }

    e
    {
        solver               smoothSolver;
        smoother             DILUGaussSeidel;
        tolerance            1e-06;
        relTol               0.1;
    }
    eFinal
    {
        $e;
        relTol               0.01;
    }
}

PIMPLE
{
    nOuterCorrectors          2;
    nCorrectors               2;
    nNonOrthogonalCorrectors  0;

    // --- Pressure reference (REQUIRED if no fixedValue on p at boundaries) ---
    // Option A: reference cell (cell label in the global mesh)
    pRefCell                  0;
    pRefValue                 0;

    // Option B (alternative): reference point in space (use only if you prefer)
    // pRefPoint                 (0 0 0);
    // pRefValue                 0;

    // Dictionary-form residualControl (PIMPLE expects dictionary form)
    residualControl
    {
        p       { tolerance 1e-05; relTol 0.01; }
        U       { tolerance 1e-05; relTol 0.01; }
        k       { tolerance 1e-05; relTol 0.01; }
        epsilon { tolerance 1e-05; relTol 0.01; }

        omega   { tolerance 1e-05; relTol 0.01; }
        nuTilda { tolerance 1e-05; relTol 0.01; }
        nut     { tolerance 1e-05; relTol 0.01; }

        T       { tolerance 1e-05; relTol 0.01; }
        h       { tolerance 1e-05; relTol 0.01; }
        e       { tolerance 1e-05; relTol 0.01; }
    }
}

// PISO (ignored by pimpleFoam)
PISO
{
    nCorrectors               2;
    nNonOrthogonalCorrectors  0;
}

relaxationFactors
{
    p        0.7;
    U        0.2;
    k        0.5;
    epsilon  0.5;
    omega    0.5;
    nuTilda  0.5;
    nut      0.5;
    T        0.5;
    h        0.5;
    e        0.5;
}
